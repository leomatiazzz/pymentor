# Exemplo de variáveis de ambiente para o PyMentor
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA compartilhe o arquivo .env em repositórios públicos.

# ──────────────────────────────────────────────
# Django — Configurações principais
# ──────────────────────────────────────────────

# Chave secreta do Django. Gere uma nova com:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=sua-chave-secreta-aqui

# Modo debug. Use False em produção.
DEBUG=False

# Hosts permitidos (separados por vírgula). Exemplo: meusite.com,www.meusite.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ──────────────────────────────────────────────
# Banco de dados (opcional — padrão: SQLite)
# ──────────────────────────────────────────────

# Para usar PostgreSQL em produção, configure as variáveis abaixo
# e atualize DATABASES em settings.py para lê-las.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pymentor
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432
